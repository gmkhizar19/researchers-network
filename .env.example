# Copy to .env and fill in your own values. Real values are never committed.
# All scripts read this file through backend/config.py or crawler/config.py.

# --- OpenAlex ---------------------------------------------------------------
# OpenAlex uses this to put you in the "polite pool" (faster, more reliable).
# Your real address is never written to the repository.
OPENALEX_EMAIL=you@example.com

# Optional: free key from https://openalex.org/settings/api
# OpenAlex now requires a key for cursor paging and gives anonymous users a
# small shared daily budget. The crawler does not need the key (it uses
# per-year page paging), but a key makes large reruns safer.
OPENALEX_API_KEY=

# --- Neo4j ------------------------------------------------------------------
# Must match NEO4J_PASSWORD in docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchers

# --- Backend ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Crawler scope (optional overrides) -------------------------------------
# Years and page size can be changed without editing code.
OPENALEX_YEARS=2015-2025
OPENALEX_PER_PAGE=200
